// Prisma schema for Security Guard Management SaaS
// DB: PostgreSQL (Neon / Supabase / Railway free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // used by Neon/Supabase for migrations, optional elsewhere
}

enum Role {
  ADMIN
  MANAGER
}

enum ShiftType {
  DAY
  NIGHT
  GENERAL
  ROTATIONAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum GstMode {
  COLLECTED_BY_US // GST is included in our collectable total, payable to us
  PAID_DIRECTLY_BY_SOCIETY // GST is shown for reference only; society pays it directly to the government
}

enum SalarySlipStatus {
  GENERATED
  PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Society {
  id             String   @id @default(cuid())
  name           String
  code           String?  @unique // internal short code
  address        String
  city           String
  state          String
  pincode        String?
  billingAddress String?
  contactPerson  String
  contactPhone   String
  contactEmail   String?
  gstNumber      String?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rateConfig  RateConfig?
  assignments Assignment[]
  attendance  Attendance[]
  invoices    Invoice[]
}

// Pricing & billing setup per society
model RateConfig {
  id        String  @id @default(cuid())
  societyId String  @unique
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  ratePerGuardMonthly Decimal  @db.Decimal(12, 2) // amount client pays per guard per month
  shiftHours          Int      @default(12)
  dayGuardsRequired   Int      @default(0) // sanctioned strength for day shift, per contract
  nightGuardsRequired Int      @default(0) // sanctioned strength for night shift, per contract
  totalAgreedAmount   Decimal  @db.Decimal(12, 2) // total monthly amount agreed with client
  withGST             Boolean  @default(true)
  gstMode             GstMode  @default(COLLECTED_BY_US)
  gstPercentage       Decimal  @default(18.00) @db.Decimal(5, 2)
  effectiveFrom       DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  lines RateConfigLine[]
}

// Optional per-designation rate breakdown for a society. When present, the parent RateConfig's
// totalAgreedAmount / dayGuardsRequired / nightGuardsRequired are auto-computed as the sum across
// these rows. A RateConfig with no lines keeps using its own flat fields directly (legacy behavior).
model RateConfigLine {
  id                  String      @id @default(cuid())
  rateConfigId        String
  rateConfig          RateConfig  @relation(fields: [rateConfigId], references: [id], onDelete: Cascade)
  designationId       String
  designation         Designation @relation(fields: [designationId], references: [id])
  ratePerGuardMonthly Decimal     @db.Decimal(12, 2)
  dayGuardsRequired   Int         @default(0)
  nightGuardsRequired Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([rateConfigId])
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique // Guard, Supervisor, Head Guard, Gunman, etc.
  rank      Int      @default(0) // for sorting hierarchy
  createdAt DateTime @default(now())

  guards          Guard[]
  rateConfigLines RateConfigLine[]
}

model Guard {
  id                String      @id @default(cuid())
  name              String
  phone             String
  altPhone          String?
  address           String?
  designationId     String
  designation       Designation @relation(fields: [designationId], references: [id])
  actualSalary      Decimal     @db.Decimal(12, 2) // what we pay the guard
  joiningDate       DateTime    @default(now())
  aadharNumber      String?
  aadharDocData     String? // base64-encoded Aadhaar file content (PDF or image)
  aadharDocFileName String?
  aadharDocMimeType String?
  photoUrl          String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  assignments    Assignment[]
  attendance     Attendance[]
  salaryAdvances SalaryAdvance[]
  salarySlips    SalarySlip[]
}

// Maps a guard to a society + shift
model Assignment {
  id        String    @id @default(cuid())
  guardId   String
  guard     Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  societyId String
  society   Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  shiftType ShiftType @default(GENERAL)
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([societyId])
  @@index([guardId])
}

model Attendance {
  id        String           @id @default(cuid())
  guardId   String
  guard     Guard            @relation(fields: [guardId], references: [id], onDelete: Cascade)
  societyId String
  society   Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  shiftType ShiftType        @default(GENERAL)
  remarks   String?
  createdAt DateTime         @default(now())

  @@unique([guardId, date, shiftType])
  @@index([societyId, date])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  societyId     String
  society       Society       @relation(fields: [societyId], references: [id])
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  guardsBilled  Int
  baseAmount    Decimal       @db.Decimal(12, 2)
  gstPercentage Decimal       @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(12, 2)
  gstMode       GstMode       @default(COLLECTED_BY_US) // snapshot of the society's GST mode at generation time
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// A cash advance given to a guard, to be netted off a future month's salary slip.
// Status shown in the UI ("pending" / "adjusted") is derived: salarySlipId == null ? pending : adjusted.
model SalaryAdvance {
  id              String   @id @default(cuid())
  guardId         String
  guard           Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime @db.Date
  adjustmentMonth DateTime @db.Date // normalized to the 1st, e.g. 2026-10-01 = "October 2026"
  notes           String?

  salarySlipId String?
  salarySlip   SalarySlip? @relation(fields: [salarySlipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guardId])
  @@index([adjustmentMonth])
}

// A generated, immutable monthly salary record for one guard. Snapshots the attendance
// breakdown and agreed salary at generation time so later attendance corrections don't
// silently change history — regenerate (delete + create again) if a correction is needed.
model SalarySlip {
  id      String   @id @default(cuid())
  guardId String
  guard   Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  month   DateTime @db.Date // normalized to the 1st, e.g. 2026-10-01 = "October 2026"

  agreedSalary     Decimal @db.Decimal(12, 2) // snapshot of Guard.actualSalary at generation time
  totalDaysInMonth Int
  presentDays      Int     @default(0)
  halfDays         Int     @default(0)
  leaveDays        Int     @default(0)
  weeklyOffDays    Int     @default(0)
  absentDays       Int     @default(0)
  unmarkedDays     Int     @default(0) // calendar days in the month with no attendance record at all
  payableDays      Decimal @db.Decimal(6, 2)

  grossSalary     Decimal @db.Decimal(12, 2) // agreedSalary * payableDays / totalDaysInMonth
  advanceDeducted Decimal @default(0) @db.Decimal(12, 2)
  netPayable      Decimal @db.Decimal(12, 2)

  status SalarySlipStatus @default(GENERATED)
  paidOn DateTime?        @db.Date
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advances SalaryAdvance[] // advances this slip consumed/adjusted

  @@unique([guardId, month]) // one slip per guard per month; delete + regenerate to correct
  @@index([month])
}
