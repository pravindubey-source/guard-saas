// Prisma schema for Security Guard Management SaaS
// DB: PostgreSQL (Neon / Supabase / Railway free tier)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // used by Neon/Supabase for migrations, optional elsewhere
}

enum Role {
  ADMIN
  MANAGER
}

enum ShiftType {
  DAY
  NIGHT
  GENERAL
  ROTATIONAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Society {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique // internal short code
  address         String
  city            String
  state           String
  pincode         String?
  billingAddress  String?
  contactPerson   String
  contactPhone    String
  contactEmail    String?
  gstNumber       String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rateConfig   RateConfig?
  assignments  Assignment[]
  attendance   Attendance[]
  invoices     Invoice[]
}

// Pricing & billing setup per society
model RateConfig {
  id                  String   @id @default(cuid())
  societyId           String   @unique
  society             Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)

  ratePerGuardMonthly  Decimal  @db.Decimal(12, 2) // amount client pays per guard per month
  shiftHours           Int      @default(12)
  dayGuardsRequired    Int      @default(0) // sanctioned strength for day shift, per contract
  nightGuardsRequired  Int      @default(0) // sanctioned strength for night shift, per contract
  totalAgreedAmount    Decimal  @db.Decimal(12, 2) // total monthly amount agreed with client
  withGST              Boolean  @default(true)
  gstPercentage        Decimal  @db.Decimal(5, 2) @default(18.00)
  effectiveFrom        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique // Guard, Supervisor, Head Guard, Gunman, etc.
  rank      Int      @default(0) // for sorting hierarchy
  createdAt DateTime @default(now())

  guards Guard[]
}

model Guard {
  id             String    @id @default(cuid())
  name           String
  phone          String
  altPhone       String?
  address        String?
  designationId  String
  designation    Designation @relation(fields: [designationId], references: [id])
  actualSalary   Decimal   @db.Decimal(12, 2) // what we pay the guard
  joiningDate    DateTime  @default(now())
  aadharNumber   String?
  photoUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignments Assignment[]
  attendance  Attendance[]
}

// Maps a guard to a society + shift
model Assignment {
  id         String    @id @default(cuid())
  guardId    String
  guard      Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  societyId  String
  society    Society   @relation(fields: [societyId], references: [id], onDelete: Cascade)
  shiftType  ShiftType @default(GENERAL)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([societyId])
  @@index([guardId])
}

model Attendance {
  id         String            @id @default(cuid())
  guardId    String
  guard      Guard             @relation(fields: [guardId], references: [id], onDelete: Cascade)
  societyId  String
  society    Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  date       DateTime          @db.Date
  status     AttendanceStatus  @default(PRESENT)
  shiftType  ShiftType         @default(GENERAL)
  remarks    String?
  createdAt  DateTime          @default(now())

  @@unique([guardId, date, shiftType])
  @@index([societyId, date])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  societyId      String
  society        Society       @relation(fields: [societyId], references: [id])
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  guardsBilled   Int
  baseAmount     Decimal       @db.Decimal(12, 2)
  gstPercentage  Decimal       @db.Decimal(5, 2) @default(0)
  gstAmount      Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
